{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopForge",
  "version": "1.0.0",
  "identifier": "com.loopforge.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "LoopForge Team",
    "shortDescription": "LoopForge - AI agent orchestration platform",
    "icon": [
      "icons/icon.ico",
      "icons/icon-32x32.ico",
      "icons/icon-128x128.ico"
    ],
    "resources": {
      "../bin/loopforge-backend.exe": "bin/loopforge-backend.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
